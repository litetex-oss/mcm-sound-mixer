{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "${desc}",
  "authors": [
    "litetex"
  ],
  "contributors": [
    {
      "name": "BVengo & Sound Controller mod contributors",
      "contact": {
        "homepage": "https://github.com/BVengo/sound-controller"
      }
    }
  ],
  "contact": {
    "homepage": "https://modrinth.com/mod/${id}",
    "sources": "https://github.com/litetex-oss/mcm-${id}",
    "issues": "https://github.com/litetex-oss/mcm-${id}/issues"
  },
  "license": "${license_spdx_id}",
  "icon": "assets/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "net.litetex.soundmixer.fabric.FabricSoundMixer"
    ],
    "modmenu": [
      "net.litetex.soundmixer.fabric.compat.ModMenuCompatibility"
    ]
  },
  "mixins": [
    "sound-mixer.mixins.json"
  ],
  "accessWidener": "sound-mixer.classtweaker",
  "recommends": {
    "fabricloader": ">=${loader_version}",
    "minecraft": ">=${minecraft_version}"
  },
  "conflicts": {
    "soundcontroller": "*",
    "soundsbegone": "*",
    "extremesoundmuffler": "*"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.github_releases": "https://github.com/litetex-oss/mcm-${id}/releases",
        "modmenu.modrinth": "https://modrinth.com/mod/${id}"
      }
    }
  }
}
